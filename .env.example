# Permanent canonical URL (defined centrally in src/data/site.ts)
NEXT_PUBLIC_SITE_URL=https://rkpatel71-portfolio.vercel.app

# Optional future contact form delivery. No variables are required for launch:
# without a provider, visitors use the email link and Copy Email Address button.
# RESEND_API_KEY is server-only. Never expose it with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
CONTACT_EMAIL_TO=khuntronak5@gmail.com
# Set to an address on your verified Resend sending domain.
CONTACT_EMAIL_FROM=
