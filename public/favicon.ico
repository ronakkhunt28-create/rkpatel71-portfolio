  <path d="M 32 34 L 56 34 C 67 34 74 40 74 49 C 74 57 68 62 58 63 L 75 94 L 62 94 L 46 64 L 44 64 L 44 94 L 32 94 Z M 44 45 L 44 54 L 54 54 C 59 54 62 52 62 49 C 62 46 59 45 54 45 Z" fill="url(#accent)"/>

